# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection (docker compose up -d → the line below works as is, port 54320)
# Neon / production: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://lumen:lumen@127.0.0.1:54320/lumen
# Neon only: direct (non-pooled) URL used by migrations; the pooled URL goes in DATABASE_URL
# DATABASE_URL_UNPOOLED=
# Database connections per server instance (default 3, suited to serverless)
# DB_POOL_MAX=3

# Session signing key, 32+ random characters: `openssl rand -base64 48`
AUTH_SECRET=

# First administrator account created by `npm run db:seed` (password: 12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# Demo doctors in the seed (set to false for a real client)
SEED_DEMO=true

# Public URL (used in e-mails, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails (optional in development: without a key, e-mails are printed in the terminal)
RESEND_API_KEY=
EMAIL_FROM=Lumen Santé <rdv@your-domain.com>
